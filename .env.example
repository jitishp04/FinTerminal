# Copy to .env.local and fill in. All keys are free; no credit card needed.

# FRED (macro data, yield curve): https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Finnhub (quote fallback for US stocks): https://finnhub.io/register
FINNHUB_API_KEY=

# SEC EDGAR requires a User-Agent that names you and gives a contact email.
# Example: FinTerminal Jane Doe jane@example.com
SEC_USER_AGENT=
