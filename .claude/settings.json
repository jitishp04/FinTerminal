{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/install-deps.mjs\"",
            "timeout": 600,
            "statusMessage": "Checking npm dependencies"
          }
        ]
      }
    ]
  }
}
